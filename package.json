{
  "name": "hospital-database-app",
  "version": "1.0.0",
  "description": "Full-stack Hospital Database Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "server": "nodemon server.js",
    "client-install": "cd client && npm install",
    "dev-all": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "body-parser": "^1.20.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  },
  "keywords": ["hospital", "database", "mysql", "nodejs", "react"],
  "author": "Hospital DB Team",
  "license": "MIT"
}